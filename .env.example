# ==============================================================================
# Nexus Production Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# ----------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ----------------------------------------------------
DATABASE_URL=postgresql://nexus_user:nexus_secure_password_2026@localhost:5432/nexus_db?schema=public

# ----------------------------------------------------
# 2. JWT Security
# ----------------------------------------------------
JWT_SECRET=nexus_super_secret_jwt_key_production_2026_change_me_in_prod

# ----------------------------------------------------
# 3. Real Payment Gateway (Razorpay - India & Global)
# ----------------------------------------------------
# Obtain from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Obtain from Razorpay Dashboard > Settings > Webhooks > Add Endpoint
RAZORPAY_WEBHOOK_SECRET=...

# ----------------------------------------------------
# 4. WebRTC TURN / STUN Server Configuration
# ----------------------------------------------------
TURN_URL=turn:localhost:3478
TURN_USERNAME=nexus_user
TURN_CREDENTIAL=nexus_turn_password_2026

# ----------------------------------------------------
# 5. HTTPS / SSL Configuration
# ----------------------------------------------------
HTTPS_ENABLED=false
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.cert
